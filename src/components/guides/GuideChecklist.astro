---
interface Props {
  items: string[];
  numbered?: boolean;
}

const { items, numbered = false } = Astro.props;
---

<ul class="grid gap-3">
  {
    items.map((item, index) => (
      <li class="flex items-start gap-3 rounded-2xl border border-black/10 bg-white p-4">
        {numbered ? (
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f3b2f] text-xs font-semibold text-white">
            {index + 1}
          </span>
        ) : (
          <span class="mt-1 text-primary">✓</span>
        )}
        <span class="leading-7 text-muted">{item}</span>
      </li>
    ))
  }
</ul>
