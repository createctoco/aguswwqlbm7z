---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '8 mm vs. 10 mm Rosary Beads',
  description: 'Compare 8 mm and 10 mm beads for wholesale rosary sourcing.',
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '8 mm vs. 10 mm Rosary Beads',
  description: metadata.description,
  dateModified: '2026-08-08',
  mainEntityOfPage: 'https://ouooo.com/guides/8mm-vs-10mm-beads',
  author: { '@type': 'Organization', name: 'OUOOO', url: 'https://ouooo.com' },
  publisher: { '@type': 'Organization', name: 'OUOOO', url: 'https://ouooo.com' },
};

const options = [
  [
    '8 mm',
    'Lighter and compact',
    'Everyday rosaries and bracelets',
    'An 8 mm rosary feels lighter on the wrist and in the hand, sits neatly in a pocket or small gift box, and suits daily carry, travel, and one-decade styles.',
  ],
  [
    '10 mm',
    'More substantial',
    'Gift sets and statement pieces',
    'A 10 mm rosary has stronger visual presence and easier handling. The larger beads read clearly in product photos and give a more substantial, premium gift presentation.',
  ],
];

const constructionFactors = [
  'Material density — a dense bead such as stone or glass weighs more than wood or acrylic at the same size.',
  'Connector style — chain, cord, knots, and elastic all change how the rosary drapes and handles.',
  'Medal and centerpiece size — larger components need enough bead spacing to balance the finished piece.',
  'Crucifix weight — a heavier crucifix can change the balance and feel of the whole rosary.',
];
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <section class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Sourcing guide · Specifications</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">8 mm vs. 10 mm rosary beads</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">
        Choose 8 mm beads for a lighter, more compact rosary. Choose 10 mm beads when you want stronger visual presence,
        easier handling, and a more substantial gift presentation.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="btn-primary" href="/products">Explore product concepts</a>
        <a class="btn-secondary" href="/contact">Ask about bead sizes</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 md:grid-cols-2">
      {
        options.map(([size, feel, direction, text]) => (
          <article class="rounded-2xl border border-black/10 bg-white p-7">
            <div class="flex items-center justify-between">
              <h2 class="text-3xl font-semibold">{size}</h2>
              <span class="rounded-full bg-[#f6f1e8] px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-primary">
                {feel}
              </span>
            </div>
            <p class="mt-4 text-sm font-semibold uppercase tracking-[.14em] text-muted">Common direction</p>
            <p class="mt-2 text-lg font-semibold">{direction}</p>
            <p class="mt-4 leading-7 text-muted">{text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-[#f4f5f2] py-16">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">At a glance</p>
      <h2 class="mt-3 text-3xl font-semibold">Size comparison</h2>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-black/10 bg-white">
        <table class="w-full min-w-[560px] border-collapse text-left text-sm">
          <thead class="bg-[#f6f1e8]">
            <tr>
              <th class="p-4 font-semibold">Size</th>
              <th class="p-4 font-semibold">Feel</th>
              <th class="p-4 font-semibold">Common direction</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-black/10">
            <tr>
              <td class="p-4 font-semibold">8 mm</td>
              <td class="p-4 text-muted">Lighter and compact</td>
              <td class="p-4 text-muted">Everyday rosaries and bracelets</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold">10 mm</td>
              <td class="p-4 text-muted">More substantial</td>
              <td class="p-4 text-muted">Gift sets and statement pieces</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Beyond bead size</p>
        <h2 class="mt-3 text-3xl font-semibold">Consider the complete construction</h2>
        <p class="mt-5 leading-8 text-muted">
          Bead size is only one factor. The material, connectors, medals, and crucifix all contribute to how a finished
          rosary feels, drapes, and presents.
        </p>
      </div>
      <ul class="grid gap-3">
        {
          constructionFactors.map((item) => (
            <li class="flex items-start gap-3 rounded-2xl border border-black/10 bg-white p-4">
              <span class="mt-1 text-primary">✓</span>
              <span class="leading-7 text-muted">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-[#0f3b2f] text-white">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[.16em] text-[#d8c5a3]">Need help deciding?</p>
          <h2 class="mt-3 text-3xl font-semibold">Tell us your target market and bead size preference.</h2>
          <p class="mt-4 leading-8 text-white/80">
            Share the destination market, intended user, bead material, and packaging format. We will confirm what is
            available and help you compare samples before ordering.
          </p>
        </div>
        <a
          class="inline-flex shrink-0 items-center justify-center rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-[#0f3b2f]"
          href="/contact"
        >
          Discuss your requirements
        </a>
      </div>
    </div>
  </section>
</Layout>
