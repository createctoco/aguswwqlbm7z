---
interface Props {
  eyebrow?: string;
  title?: string;
  href?: string;
  buttonLabel?: string;
}

const { eyebrow, title, href, buttonLabel } = Astro.props;
---

<div class="flex h-full flex-col justify-center rounded-2xl border border-black/10 bg-white p-7">
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">{eyebrow}</p>}
  {title && <h3 class="mt-3 text-2xl font-semibold">{title}</h3>}
  <div class="mt-4 leading-7 text-muted">
    <slot />
  </div>
  {
    href && buttonLabel && (
      <a class="btn-primary mt-7 self-start" href={href}>
        {buttonLabel}
      </a>
    )
  }
</div>
