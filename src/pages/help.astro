---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Help Center & Wholesale FAQ',
  description: 'Answers about OUOOO wholesale inquiries, samples, MOQ, customization, lead times, shipping, and Catholic products.',
};

const faqs = [
  {
    question: 'Does OUOOO support custom products?',
    answer:
      'Yes. Depending on the product and quantity, customization may include material, bead color and size, crucifix or centerpiece style, knotting, metal finish, logo, insert card, and retail packaging. Send a reference image, artwork, target quantity, and destination for evaluation.',
  },
  {
    question: 'What is the minimum order quantity?',
    answer:
      'MOQ depends on whether the item is in stock, requires a color or packaging change, or needs new tooling and full OEM production. We confirm the applicable MOQ in the quotation instead of applying one number to every product.',
  },
  {
    question: 'Can I request a sample before a bulk order?',
    answer:
      'Samples are often available for stock products. Custom samples may require a sampling or tooling charge. Availability, sample cost, and freight are confirmed before dispatch.',
  },
  {
    question: 'How do I receive a wholesale quotation?',
    answer:
      'Send the product link or reference, quantity, destination country, preferred material or color, and packaging requirements through WhatsApp, WeChat, or email. More complete information produces a more accurate quotation.',
  },
  {
    question: 'How long do sampling and production take?',
    answer:
      'Timing depends on design complexity, materials, tooling, quantity, and seasonal capacity. We provide an estimated sample and production schedule after reviewing the specification. The written quotation or order confirmation contains the final schedule.',
  },
  {
    question: 'Do you ship internationally?',
    answer:
      'Yes. Shipping options depend on carton size, weight, destination, urgency, and customs requirements. We can discuss express, air, or sea freight where appropriate.',
  },
  {
    question: 'Are the religious products blessed or consecrated?',
    answer:
      'Unless a product page or written quotation explicitly says otherwise, items are supplied as unblessed devotional goods. Buyers can arrange a blessing through their parish, priest, or other authorized clergy after receiving the goods.',
  },
  {
    question: 'What happens if there is a quality or shipping problem?',
    answer:
      'Contact us promptly with the product reference, quantity affected, packaging photos, and clear images or video of the issue. We review each case against the approved sample or written specification and agree an appropriate remedy.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-5xl px-6 py-20 text-center">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Help Center</p>
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">Answers for wholesale buyers.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted">
        Practical guidance before you request a quote, sample a product, or start a custom project.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-5 md:grid-cols-2 md:items-stretch">
      {
        faqs.map(({ question, answer }) => (
          <article class="h-full rounded-2xl border border-black/10 bg-white p-7">
            <h2 class="text-xl font-semibold leading-7">{question}</h2>
            <p class="mt-4 leading-7 text-muted">{answer}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      <a class="rounded-2xl bg-[#f6f1e8] p-7" href="/customization">
        <p class="text-xs font-semibold uppercase tracking-[.14em] text-primary">Custom projects</p>
        <h2 class="mt-3 text-xl font-semibold">Customization guide →</h2>
      </a>
      <a class="rounded-2xl bg-[#f1ece5] p-7" href="/returns">
        <p class="text-xs font-semibold uppercase tracking-[.14em] text-primary">After-sales</p>
        <h2 class="mt-3 text-xl font-semibold">Return policy →</h2>
      </a>
      <a class="rounded-2xl bg-[#e9efe9] p-7" href="/contact">
        <p class="text-xs font-semibold uppercase tracking-[.14em] text-primary">Still need help?</p>
        <h2 class="mt-3 text-xl font-semibold">Contact OUOOO →</h2>
      </a>
    </div>
  </section>
</Layout>
