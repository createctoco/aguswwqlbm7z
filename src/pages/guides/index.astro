---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guide', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.publishDate?.getTime() || 0) - (a.data.publishDate?.getTime() || 0) || a.id.localeCompare(b.id)
);

const metadata = {
  title: 'Sourcing Guides',
  description: 'Practical guidance for sourcing rosaries and custom religious gifts.',
};
---

<Layout metadata={metadata}>
  <header class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Knowledge for buyers</p>
      <h1 class="mt-4 text-4xl font-semibold">Sourcing guides</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">
        Clear, practical answers about materials, sizing, customization, and packaging.
      </p>
    </div>
  </header>

  <main class="mx-auto grid max-w-6xl gap-7 px-6 py-16 md:grid-cols-2">
    {
      guides.map((guide) => (
        <a class="rounded-2xl border border-black/10 p-8" href={`/guides/${guide.id}`}>
          <p class="text-xs font-medium uppercase tracking-[.14em] text-primary">{guide.data.category || 'Guide'}</p>
          <h2 class="mt-4 text-2xl font-semibold">{guide.data.title}</h2>
          {guide.data.excerpt && <p class="mt-4 leading-7 text-muted">{guide.data.excerpt}</p>}
        </a>
      ))
    }
  </main>
</Layout>
