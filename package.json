{
  "name": "ouooo-site",
  "version": "0.1.0",
  "description": "Pure-static English B2B product catalog and inquiry website for OUOOO.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run cf:types && node scripts/validate-locale-build.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "sync:catalog": "node --env-file-if-exists=.env scripts/catalog-client.mjs",
    "enrich:catalog": "node --env-file-if-exists=.env scripts/enrich-catalog.mjs",
    "prepare:catalog": "node --env-file-if-exists=.env scripts/build-site-catalog.mjs",
    "translate:catalog": "node --env-file-if-exists=.env scripts/translate-catalog.mjs",
    "stamp:localization": "node scripts/stamp-catalog-localization.mjs",
    "prepare:d1": "node scripts/build-d1-import.mjs",
    "cf:types": "wrangler types src/cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply ouooo-catalog --local",
    "db:import:local": "npm run prepare:d1 && wrangler d1 execute ouooo-catalog --local --file .d1/import-en.sql",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "precheck:astro": "npm run cf:types",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w ."
  },
  "dependencies": {
    "@astro-community/astro-embed-twitter": "^0.5.11",
    "@astro-community/astro-embed-vimeo": "^0.3.12",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.1.4",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/partytown": "^2.1.7",
    "@eslint/js": "^10.0.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "astro-compress": "^2.3.8",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "js-yaml": "^4.1.1",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "astro-compress": {
      "sharp": "^0.35.3",
      "svgo": "^4.0.2"
    }
  }
}

