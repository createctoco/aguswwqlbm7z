---
import Layout from '~/layouts/PageLayout.astro';
import { getWhatsAppUrl } from '~/config/contact';

const metadata = {
  title: 'Stock Wholesale - Wholesale Rosaries & Custom Religious Gifts',
  description: 'Over 900 SKUs in a 1,000 m² warehouse. Most styles kept in 1,000+ piece stock. Ships within 10 days.',
};

const stats = [
  { value: '1,000 m²', label: 'Warehouse space' },
  { value: '900+', label: 'SKUs in stock' },
  { value: '1,000+', label: 'Pieces per style' },
  { value: '10 days', label: 'Typical dispatch' },
];

const advantages = [
  [
    'Large ready-to-ship inventory',
    'Our 1,000-square-meter warehouse holds over 900 SKUs of Catholic rosaries, religious gifts, and devotional accessories. Most styles are stocked in quantities of 1,000 pieces or more, so you can order what you need without waiting for a production run.',
  ],
  [
    'Fast fulfillment',
    'For in-stock items, we typically dispatch within 10 days of order confirmation. No minimum order quantity on catalog products — buy what you need, when you need it.',
  ],
  [
    'Skilled workforce',
    'We work with a network of experienced craftspeople and assembly workers. Their familiarity with our product range means consistent quality, quick restocking, and the flexibility to handle bulk orders without compromising standards.',
  ],
  [
    'Flexible for bulk buyers',
    'Need 500 of one style? 5,000 mixed across a collection? Our inventory depth lets us fulfill both. And when you need more than what is on the shelf, production capacity kicks in seamlessly.',
  ],
];

const faqs = [
  [
    'What is the minimum order quantity for stock wholesale?',
    'There is no strict MOQ for in-stock catalog items. You can order as few as you need. For larger or mixed orders, we can provide a volume quote.',
  ],
  [
    'How fast can you ship?',
    'In-stock orders are typically dispatched within 10 days of confirmed payment. Shipping time depends on your destination and chosen carrier.',
  ],
  [
    'Can I mix different products in one order?',
    'Yes. You can combine any in-stock items in a single shipment. We will consolidate packing to keep freight costs down.',
  ],
  [
    'What if a product is out of stock?',
    'If an item is temporarily out of stock, we will tell you upfront with an estimated restock date or offer a comparable alternative from our catalog.',
  ],
];

const whatsappUrl = getWhatsAppUrl('Hello OUOOO, I would like to ask about your stock wholesale inventory.');
---

<Layout metadata={metadata}>
  <section class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Ready-to-ship</p>
      <h1 class="mt-4 text-4xl font-semibold">Stock Wholesale from a 1,000 m² Warehouse</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">
        We keep deep inventory so you do not have to wait. Over 900 SKUs of Catholic rosaries, religious gifts, and
        devotional accessories — most styles in 1,000+ piece quantities — ready to pick, pack, and ship.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="rounded-2xl border border-black/10 bg-white p-7 text-center">
            <p class="text-3xl font-bold text-primary">{stat.value}</p>
            <p class="mt-2 text-sm text-muted">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-[#f4f5f2] py-16">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-semibold">Why buyers choose our stock inventory</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {
          advantages.map(([title, body]) => (
            <article class="rounded-2xl bg-white p-7">
              <h3 class="text-xl font-semibold">{title}</h3>
              <p class="mt-3 leading-7 text-muted">{body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="text-3xl font-semibold">Frequently asked questions</h2>
    <div class="mt-8 grid gap-4">
      {
        faqs.map(([question, answer]) => (
          <details class="rounded-2xl border border-black/10 bg-white p-6">
            <summary class="cursor-pointer text-lg font-semibold">{question}</summary>
            <p class="mt-3 leading-7 text-muted">{answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="bg-[#f6f1e8] py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-semibold">Ready to order from stock?</h2>
      <p class="mt-4 text-lg text-muted">
        Send us the products and quantities you need. We will confirm availability and dispatch timeline right away.
      </p>
      <a class="btn-primary mt-8 inline-block" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        Check stock on WhatsApp
      </a>
    </div>
  </section>
</Layout>
