---
import Layout from '~/layouts/PageLayout.astro';
import { getWhatsAppUrl } from '~/config/contact';

const metadata = {
  title: 'Sourcing Agent in China — OUOOO',
  description:
    'End-to-end sourcing from Yiwu: product research, supplier negotiation, quality control, and door-to-door delivery.',
};

const stats = [
  { value: '10+', label: 'Years experience' },
  { value: '5M+', label: 'Products sourced' },
  { value: '50+', label: 'Countries served' },
];

const steps = [
  [
    '01',
    'Initial Communication',
    'Send us product photos and detailed specifications. We take time to understand your requirements — type, quantity, budget, quality level. A $1 per product type initiation fee starts the process.',
  ],
  [
    '02',
    'Market Research',
    'We conduct comprehensive market analysis across Yiwu’s vast supplier network, identifying the best-fitting factories for your needs — with up-to-date pricing and market intelligence.',
  ],
  [
    '03',
    'Quotations & Samples',
    'We contact competitive suppliers on your behalf, collect quotes and request physical samples. You get a clear comparison to make an informed decision — no guesswork.',
  ],
  [
    '04',
    'Client Confirmation',
    'We present all quotations, sample photos, and factory assessments. You review, compare, and confirm your final selection. We handle all coordination with the supplier.',
  ],
  [
    '05',
    'Order & Payment',
    'Typically 30% deposit to begin production, with the remaining 70% after inspection. Our service fee is 1–3% of order value — transparent from the start.',
  ],
  [
    '06',
    'QC, Inspection & Shipping',
    'We track production progress, communicate with the factory throughout, and provide photo and video updates before shipment. Only after your approval do we arrange delivery to your door.',
  ],
];

const pricing = [
  [
    'Initiation Fee',
    '$1',
    'Per product type to start the sourcing process. Covers initial research & supplier identification.',
  ],
  [
    'Service Commission',
    '1–3%',
    'Of total order value, scaling with order complexity. Includes negotiation, QC & logistics coordination.',
  ],
  [
    'Payment Terms',
    '30 / 70',
    '30% deposit to start production, 70% after final inspection. Standard terms — flexible for returning clients.',
  ],
];

const advantages = [
  [
    'Professional Team',
    'Experienced sourcing specialists who know Yiwu’s markets inside out — fluent in negotiation, logistics, and quality standards.',
  ],
  [
    'One-Stop Service',
    'From the first inquiry to delivery at your warehouse — research, sourcing, QC, customs, and shipping, all under one roof.',
  ],
  [
    'Quality First',
    'Photo and video proof at every stage. We don’t ship anything until you have seen it and approved it.',
  ],
  [
    'Flexible Solutions',
    'Small trial orders or large-scale production — we adapt to your needs, timeline, and budget without compromising standards.',
  ],
];

const whatsappUrl = getWhatsAppUrl('Hello OUOOO, I would like to discuss sourcing agent services.');
---

<Layout metadata={metadata}>
  <section class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Sourcing Agent</p>
      <h1 class="mt-4 text-4xl font-semibold">Your Sourcing Partner in China</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">
        From product research to door-to-door delivery — we handle the complexity so you can focus on growing your
        business.
      </p>
      <div class="mt-10 flex flex-wrap gap-10">
        {
          stats.map((stat) => (
            <div>
              <p class="text-3xl font-bold text-primary">{stat.value}</p>
              <p class="mt-1 text-sm text-muted">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="text-3xl font-semibold">How It Works</h2>
    <p class="mt-3 text-lg text-muted">A clear process, from first contact to final delivery.</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        steps.map(([num, title, body]) => (
          <article class="rounded-2xl border border-black/10 bg-white p-7">
            <p class="text-sm font-bold text-primary">{num}</p>
            <h3 class="mt-3 text-xl font-semibold">{title}</h3>
            <p class="mt-3 leading-7 text-muted">{body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-[#f4f5f2] py-16">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-semibold">Transparent Pricing</h2>
      <p class="mt-3 text-lg text-muted">No hidden fees. You know exactly what you pay.</p>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          pricing.map(([title, value, body]) => (
            <article class="rounded-2xl bg-white p-7 text-center">
              <p class="text-3xl font-bold text-primary">{value}</p>
              <h3 class="mt-3 text-lg font-semibold">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="text-3xl font-semibold">Why OUOOO</h2>
    <p class="mt-3 text-lg text-muted">We are not a brokerage. We are your team on the ground.</p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        advantages.map(([title, body]) => (
          <article class="rounded-2xl border border-black/10 bg-white p-7">
            <h3 class="text-xl font-semibold">{title}</h3>
            <p class="mt-3 leading-7 text-muted">{body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-[#f6f1e8] py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-semibold">Ready to start sourcing from China?</h2>
      <p class="mt-4 text-lg text-muted">
        Whether you are an entrepreneur, a small business, or a large corporation — we are here to make it simple,
        reliable, and transparent.
      </p>
      <a class="btn-primary mt-8 inline-block" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        Contact Us Today
      </a>
    </div>
  </section>
</Layout>
