---
interface Props {
  accent: string;
  label?: string;
  large?: boolean;
  imageUrl?: string;
}
const { accent, label = 'Product image', large = false, imageUrl = '' } = Astro.props;
---

<div class:list={['product-visual', { large }]} style={`--bead:${accent}`} role="img" aria-label={label}>
  {
    imageUrl ? (
      <img src={imageUrl} alt={label} loading={large ? 'eager' : 'lazy'} decoding="async" width="900" height="1125" />
    ) : (
      <div class="strand" aria-hidden="true">
        {Array.from({ length: large ? 13 : 9 }).map((_, index) => (
          <i style={`--i:${index}`} />
        ))}
        <b />
      </div>
    )
  }
</div>

<style>
  .product-visual {
    aspect-ratio: 1/1;
    border-radius: 1.25rem;
    background: linear-gradient(145deg, #fff 0%, #f3eee5 100%);
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(37 42 38 / 0.08);
  }
  .product-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #fff;
  }
  .strand {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    width: 72%;
    gap: 0.35rem;
    transform: rotate(-8deg);
  }
  i {
    display: block;
    width: clamp(1rem, 3vw, 1.8rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 25%,
      #fff9 0 12%,
      var(--bead) 52%,
      color-mix(in srgb, var(--bead), #000 24%) 100%
    );
    box-shadow: 0 3px 8px #2c221522;
  }
  b {
    display: block;
    width: 2.2rem;
    height: 3.5rem;
    margin: 0.2rem 42%;
    position: relative;
  }
  b:before,
  b:after {
    content: '';
    position: absolute;
    background: color-mix(in srgb, var(--bead), #000 28%);
    border-radius: 4px;
  }
  b:before {
    width: 0.55rem;
    height: 3.3rem;
    left: 0.82rem;
  }
  .strand b:after {
    width: 2.2rem;
    height: 0.55rem;
    left: 0;
    top: 0.8rem;
  }
  .large .strand {
    width: 64%;
    gap: 0.55rem;
  }
  .large i {
    width: clamp(1.45rem, 4vw, 2.5rem);
  }
</style>
