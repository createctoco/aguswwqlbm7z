---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import ProductVisual from '~/components/ouooo/ProductVisual.astro';
import { products } from '~/data/products';

const metadata = {
  title: 'Wholesale Rosaries & Custom Religious Gifts',
  description: 'Explore curated rosaries, devotional jewelry and custom religious gift ideas for global wholesale buyers.',
};
---
<Layout metadata={metadata}>
  <section class="relative overflow-hidden border-b border-black/5 bg-[#f6f1e8]">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-[1.05fr_.95fr] lg:py-28">
      <div>
        <p class="mb-5 text-xs font-semibold uppercase tracking-[.16em] text-primary">Curated for global buyers</p>
        <h1 class="max-w-3xl text-4xl font-medium leading-[1.1] tracking-tight text-gray-950 sm:text-5xl">Objects of meaning,<br/><span class="font-normal text-primary">made to connect.</span></h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-gray-700">Discover rosaries, devotional jewelry, and custom religious gifts through a clearer, more thoughtful sourcing experience.</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a class="btn-primary" href="/products">Explore products</a>
          <a class="btn-secondary" href="/contact">Start a custom project</a>
        </div>
        <p class="mt-8 text-sm text-muted">Materials · Variants · Packaging · Private label</p>
      </div>
      <div class="mx-auto w-full max-w-xl"><ProductVisual large accent="#8a6348" label="Curated rosary collection" /></div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div><p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Explore the collection</p><h2 class="mt-3 text-3xl font-semibold text-gray-950">Distinctive pieces, clearly presented.</h2></div>
      <a class="text-sm font-semibold text-primary" href="/products">View all products →</a>
    </div>
    <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">{products.map((product) => <ProductCard product={product} />)}</div>
  </section>

  <section class="bg-[#20251f] text-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-20 lg:grid-cols-2">
      <div><p class="text-xs font-semibold uppercase tracking-[.16em] text-[#d4b37f]">Made for your market</p><h2 class="mt-4 max-w-xl text-3xl font-semibold leading-tight">A sourcing catalog built around decisions—not checkout.</h2></div>
      <div class="grid gap-7 sm:grid-cols-2">
        {['Choose materials with confidence','Compare bead sizes and styles','Plan private-label packaging','Send one clear wholesale inquiry'].map((item,index) => <div class="border-t border-white/20 pt-4"><span class="text-xs text-[#d4b37f]">0{index+1}</span><p class="mt-2 text-lg">{item}</p></div>)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="grid gap-8 lg:grid-cols-3">
      <div><p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Sourcing guides</p><h2 class="mt-3 text-3xl font-semibold">Useful answers before you order.</h2><a class="mt-6 inline-block text-sm font-semibold text-primary" href="/guides">Browse all guides →</a></div>
      <a href="/guides/choosing-rosary-materials" class="rounded-2xl bg-[#f6f1e8] p-8"><p class="text-xs font-medium uppercase tracking-[.14em] text-muted">Materials</p><h3 class="mt-4 text-xl font-semibold">How to choose the right rosary bead material</h3><p class="mt-4 leading-7 text-muted">Compare wood, glass, acrylic, and natural stone for different markets.</p></a>
      <a href="/guides/8mm-vs-10mm-beads" class="rounded-2xl bg-[#f1ece5] p-8"><p class="text-xs font-medium uppercase tracking-[.14em] text-muted">Specifications</p><h3 class="mt-4 text-xl font-semibold">8 mm vs. 10 mm rosary beads</h3><p class="mt-4 leading-7 text-muted">Understand feel, weight, presentation, and buyer preference.</p></a>
    </div>
  </section>
</Layout>
