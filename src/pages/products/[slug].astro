---
import Layout from '~/layouts/PageLayout.astro';
import ProductVisual from '~/components/ouooo/ProductVisual.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import { products } from '~/data/products';
export function getStaticPaths(){ return products.map(product=>({params:{slug:product.slug},props:{product}})); }
const { product } = Astro.props;
const metadata = { title: product.title, description: product.summary };
const related = products.filter((item)=>item.slug!==product.slug).slice(0,3);
---
<Layout metadata={metadata}>
  <section class="mx-auto grid max-w-7xl gap-12 px-6 py-14 lg:grid-cols-2 lg:py-20">
    <ProductVisual large accent={product.accent} label={product.title}/>
    <div class="lg:py-7"><p class="text-xs font-bold uppercase tracking-[.2em] text-primary">{product.eyebrow}</p><h1 class="mt-4 font-serif text-5xl leading-tight text-gray-950">{product.title}</h1><p class="mt-6 text-lg leading-8 text-muted">{product.summary}</p>
      <dl class="mt-9 grid grid-cols-2 border-y border-black/10 py-6 text-sm"><div><dt class="text-muted">Material</dt><dd class="mt-1 font-semibold">{product.material}</dd></div><div><dt class="text-muted">Bead size</dt><dd class="mt-1 font-semibold">{product.beadSize}</dd></div><div class="mt-5"><dt class="text-muted">Style</dt><dd class="mt-1 font-semibold">{product.style}</dd></div><div class="mt-5"><dt class="text-muted">Reference</dt><dd class="mt-1 font-semibold">{product.sku}</dd></div></dl>
      <a href={`/contact?product=${product.sku}`} class="btn-primary mt-8">Request a wholesale quote</a><p class="mt-4 text-xs text-muted">No checkout. Tell us your quantity, market, and customization needs.</p>
    </div>
  </section>
  <section class="bg-[#f6f1e8]"><div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 lg:grid-cols-[1fr_1.2fr]"><h2 class="font-serif text-4xl">Product overview</h2><div><p class="text-lg leading-8">Designed as a starting point for a tailored wholesale program, this product can be adapted through materials, colors, medals, and packaging.</p><h3 class="mt-8 font-semibold uppercase tracking-wider">Key possibilities</h3><ul class="mt-4 grid gap-3 sm:grid-cols-2">{product.features.map((feature)=><li class="rounded-xl bg-white p-4">✓ {feature}</li>)}</ul></div></div></section>
  <section class="mx-auto max-w-7xl px-6 py-20"><h2 class="font-serif text-4xl">Related pieces</h2><div class="mt-9 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">{related.map((item)=><ProductCard product={item}/>)}</div></section>
</Layout>

