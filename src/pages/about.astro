---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us - Wholesale Rosaries & Custom Religious Gifts',
  description:
    'OUOOO helps global wholesale buyers discover, compare, and source rosaries, Catholic gifts, devotional jewelry, and custom religious products.',
};

const buyerTypes = [
  [
    'Catholic retailers',
    'Gift shops and specialist stores comparing products for everyday devotion, feast days, and sacramental occasions.',
  ],
  [
    'Church and parish buyers',
    'Parishes, bookstores, ministries, schools, and event organizers sourcing meaningful gifts in practical quantities.',
  ],
  [
    'Importers and distributors',
    'Professional buyers who need clearer specifications, repeatable products, packaging options, and export coordination.',
  ],
  [
    'Brands and online sellers',
    'Businesses developing differentiated collections, private labels, exclusive colors, or custom packaging for their market.',
  ],
];

const capabilities = [
  [
    'Rosaries and prayer items',
    'Traditional five-decade rosaries, one-decade styles, bracelets, chaplets, pocket pieces, and related devotional items.',
  ],
  [
    'Devotional jewelry',
    'Crosses, crucifixes, medals, pendants, bracelets, rings, saint images, and faith-inspired accessories.',
  ],
  [
    'Religious gifts',
    'Ornaments, keepsakes, sacramental gifts, church-event items, and products for Baptism, First Communion, Confirmation, and memorial use.',
  ],
  [
    'Material choices',
    'Wood, glass, acrylic, resin, stone, zinc alloy, stainless steel, brass, cord, chain, plating, and mixed constructions.',
  ],
  [
    'OEM and customization',
    'Material, color, size, component, logo, insert card, label, packaging, and new-design evaluation where feasible.',
  ],
  [
    'Packaging and presentation',
    'Simple wholesale packing, pouches, gift boxes, display cards, barcodes, private-label information, and buyer-supplied artwork.',
  ],
];

const sourcingSteps = [
  [
    '01',
    'Discover',
    'Browse products and collections by buyer intent instead of sorting through a crowded retail marketplace.',
  ],
  [
    '02',
    'Compare',
    'Review images, variants, specifications, materials, Catholic context, and practical sourcing notes.',
  ],
  [
    '03',
    'Define',
    'Share quantity, destination, target market, customization, packaging, and compliance requirements.',
  ],
  [
    '04',
    'Verify',
    'Confirm availability, sample, material, MOQ, price, lead time, shipping, and final written specifications.',
  ],
];
---

<Layout metadata={metadata}>
  <section class="bg-[#f6f1e8]">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-[1.15fr_.85fr] lg:py-24">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">About OUOOO</p>
        <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl">
          Meaningful products.<br />More practical sourcing.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-gray-700">
          OUOOO is an independent B2B sourcing catalog for rosaries, Catholic gifts, devotional jewelry, and custom
          religious products. We turn scattered product information into clearer options for global wholesale buyers.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a class="btn-primary" href="/products">Explore products</a>
          <a class="btn-secondary" href="/contact">Contact OUOOO</a>
        </div>
      </div>

      <aside class="rounded-3xl border border-black/10 bg-white p-8 shadow-sm sm:p-10">
        <p class="text-xs font-semibold uppercase tracking-[.15em] text-primary">Our purpose</p>
        <h2 class="mt-4 text-2xl font-semibold leading-8">Help buyers ask better questions before they commit.</h2>
        <p class="mt-5 leading-7 text-muted">
          Material names, finishes, dimensions, religious symbols, packaging, and customization details can be difficult
          to compare from marketplace listings alone. OUOOO organizes those details and identifies what still needs to
          be confirmed in a quotation, sample, or written specification.
        </p>
        <div class="mt-7 grid grid-cols-2 gap-3 text-sm">
          <span class="rounded-xl bg-[#f6f1e8] px-4 py-3 font-medium">Buyer-first catalog</span>
          <span class="rounded-xl bg-[#f6f1e8] px-4 py-3 font-medium">Structured details</span>
          <span class="rounded-xl bg-[#f6f1e8] px-4 py-3 font-medium">Custom sourcing</span>
          <span class="rounded-xl bg-[#f6f1e8] px-4 py-3 font-medium">Direct contact</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.15em] text-primary">Built for thoughtful sourcing</p>
        <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-4xl">
          A catalog designed around wholesale decisions.
        </h2>
        <p class="mt-6 leading-8 text-muted">
          OUOOO is not another shopping cart filled with duplicated titles. It is a product-discovery and inquiry
          platform that helps buyers move from an initial image to a usable sourcing brief.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <article class="rounded-2xl border border-black/10 p-6">
          <h3 class="text-lg font-semibold">Clearer product identity</h3>
          <p class="mt-3 leading-7 text-muted">
            Shorter titles, relevant categories, useful specifications, and stable product references.
          </p>
        </article>
        <article class="rounded-2xl border border-black/10 p-6">
          <h3 class="text-lg font-semibold">Catholic context when relevant</h3>
          <p class="mt-3 leading-7 text-muted">
            Practical explanations of symbols and devotional use without adding unsupported claims.
          </p>
        </article>
        <article class="rounded-2xl border border-black/10 p-6">
          <h3 class="text-lg font-semibold">Material and variant clarity</h3>
          <p class="mt-3 leading-7 text-muted">
            Buyer-focused comparisons plus reminders about details that require physical or written verification.
          </p>
        </article>
        <article class="rounded-2xl border border-black/10 p-6">
          <h3 class="text-lg font-semibold">A focused next step</h3>
          <p class="mt-3 leading-7 text-muted">
            WhatsApp, WeChat, and email connect each product to a practical wholesale conversation.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-black/10 bg-[#f4f5f2]">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[.15em] text-primary">Who we serve</p>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
          Different buyers, one need: reliable product understanding.
        </h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          buyerTypes.map(([title, text]) => (
            <article class="h-full rounded-2xl bg-white p-7">
              <>
                <h3 class="text-xl font-semibold">{title}</h3>
                <p class="mt-4 leading-7 text-muted">{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.15em] text-primary">What buyers can explore</p>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">From devotional pieces to complete presentation.</h2>
        <p class="mt-6 leading-8 text-muted">
          Product scope can grow over time, but every category follows the same principle: show what buyers need to
          compare and clearly identify what must be verified before production.
        </p>
        <a class="mt-7 inline-flex font-semibold text-primary" href="/collections">Browse collections →</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          capabilities.map(([title, text]) => (
            <article class="rounded-2xl border border-black/10 p-6">
              <>
                <h3 class="text-lg font-semibold">{title}</h3>
                <p class="mt-3 leading-7 text-muted">{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-[#0f3b2f] text-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <p class="text-xs font-semibold uppercase tracking-[.15em] text-[#d8c5a3]">How OUOOO works</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-semibold sm:text-4xl">
        A simple path from discovery to verified requirements.
      </h2>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          sourcingSteps.map(([number, title, text]) => (
            <article class="border-t border-white/25 pt-5">
              <>
                <span class="text-xs font-semibold text-[#d8c5a3]">{number}</span>
                <h3 class="mt-3 text-xl font-semibold">{title}</h3>
                <p class="mt-4 leading-7 text-white/70">{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="grid gap-8 lg:grid-cols-2">
      <article class="rounded-3xl bg-[#f6f1e8] p-8 sm:p-10">
        <p class="text-xs font-semibold uppercase tracking-[.15em] text-primary">Respecting religious meaning</p>
        <h2 class="mt-4 text-3xl font-semibold">Useful context without invented claims.</h2>
        <p class="mt-5 leading-8 text-muted">
          A cross, crucifix, Marian medal, saint image, and sacramental gift do not all have the same meaning. OUOOO
          adds Catholic context only when it fits the product and avoids presenting ordinary merchandise as blessed,
          consecrated, relic-bearing, or officially approved unless that status is explicitly documented.
        </p>
      </article>
      <article class="rounded-3xl bg-[#f1ece5] p-8 sm:p-10">
        <p class="text-xs font-semibold uppercase tracking-[.15em] text-primary">Verification before commitment</p>
        <h2 class="mt-4 text-3xl font-semibold">The website informs; the written specification confirms.</h2>
        <p class="mt-5 leading-8 text-muted">
          Images and descriptions help buyers shortlist products. Final material, color, dimensions, MOQ, price, sample,
          packaging, compliance, lead time, shipping, and after-sales terms must be confirmed in the quotation, approved
          sample, or order document before a bulk commitment.
        </p>
      </article>
    </div>
  </section>

  <section class="border-t border-black/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 py-16 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.15em] text-primary">Start a conversation</p><h2
          class="mt-3 text-3xl font-semibold"
        >
          Tell us what you are trying to source.
        </h2>
      </div>
      <a class="btn-primary shrink-0" href="/contact">Contact OUOOO</a>
    </div>
  </section>
</Layout>
