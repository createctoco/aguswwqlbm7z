---
import Layout from '~/layouts/PageLayout.astro';
const metadata={title:'Sourcing Guides',description:'Practical guidance for sourcing rosaries and custom religious gifts.'};
---
<Layout metadata={metadata}><header class="bg-[#f6f1e8]"><div class="mx-auto max-w-7xl px-6 py-16"><p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Knowledge for buyers</p><h1 class="mt-4 text-4xl font-semibold">Sourcing guides</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-muted">Clear, practical answers about materials, sizing, customization, and packaging.</p></div></header><main class="mx-auto grid max-w-7xl gap-7 px-6 py-16 md:grid-cols-2"><a class="rounded-2xl border border-black/10 p-8" href="/guides/choosing-rosary-materials"><p class="text-xs font-medium uppercase tracking-[.14em] text-primary">Materials</p><h2 class="mt-4 text-2xl font-semibold">How to choose rosary materials</h2><p class="mt-4 leading-7 text-muted">Compare bead materials, zinc alloy, stainless steel, brass, plating, cord, and verification requirements.</p></a><a class="rounded-2xl border border-black/10 p-8" href="/guides/8mm-vs-10mm-beads"><p class="text-xs font-medium uppercase tracking-[.14em] text-primary">Specifications</p><h2 class="mt-4 text-2xl font-semibold">8 mm vs. 10 mm rosary beads</h2><p class="mt-4 leading-7 text-muted">How size changes feel, weight, appearance, and positioning.</p></a></main></Layout>
