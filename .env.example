# Current production build: English only.
OUOOO_LOCALE=en
OUOOO_SITE_URL=https://ouooo.com
OUOOO_PUBLISHED_LOCALES=en

# Catalog synchronization secrets belong in GitHub Actions or Cloudflare secrets,
# never in a committed .env file.
MECRT_CATALOG_URL=
MECRT_CATALOG_BRIDGE_SECRET=
MECRT_CATALOG_SYNC_LIMIT=5
# Existing catalogs sync only changed products by default. Set true for a periodic reconciliation.
MECRT_CATALOG_FULL_SYNC=false
# Re-fetch a small overlap window so updates at the cursor boundary are not missed.
MECRT_CATALOG_SYNC_OVERLAP_SECONDS=300
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
