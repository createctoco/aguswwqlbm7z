---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import { products } from '~/data/products';
const metadata = { title: 'Wholesale Catholic Gifts & Religious Accessories', description: 'Browse OUOOO wholesale Catholic gifts, devotional jewelry, religious ornaments, and accessories sourced for international buyers.' };
---
<Layout metadata={metadata}>
  <header class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-xs font-bold uppercase tracking-[.2em] text-primary">Wholesale catalog</p>
      <h1 class="mt-4 max-w-4xl font-serif text-5xl text-gray-950">Catholic gifts and religious accessories for wholesale buyers.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">Explore verified product details, materials, variants, and devotional context. Request pricing and sourcing information directly—there is no online checkout.</p>
    </div>
  </header>
  <section class="mx-auto max-w-7xl px-6 py-16">
    <p class="mb-10 text-sm text-muted">Showing {products.length} synchronized products</p>
    <div class="grid gap-x-7 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">{products.map((product) => <ProductCard product={product} />)}</div>
  </section>
</Layout>
