---
import Layout from '~/layouts/PageLayout.astro';
const metadata={title:'Request a Quote',description:'Tell Ouooo what rosaries or religious gifts you are sourcing.'};
const product=Astro.url.searchParams.get('product') || '';
---
<Layout metadata={metadata}>
  <section class="bg-[#f6f1e8]"><div class="mx-auto max-w-6xl px-6 py-16"><p class="text-xs font-bold uppercase tracking-[.22em] text-primary">Wholesale inquiry</p><h1 class="mt-4 text-5xl font-semibold">Tell us what you are sourcing.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-muted">Share the product, quantity, destination, and customization you have in mind. This preview form will be connected to the inquiry service later.</p></div></section>
  <section class="mx-auto grid max-w-6xl gap-12 px-6 py-16 lg:grid-cols-[1fr_1.7fr]">
    <aside><h2 class="text-3xl font-semibold">A useful brief includes</h2><ul class="mt-6 space-y-4 text-muted"><li>✓ Product or reference number</li><li>✓ Estimated quantity</li><li>✓ Destination country</li><li>✓ Material or color preference</li><li>✓ Packaging and private-label needs</li></ul></aside>
    <form class="grid gap-6 rounded-2xl border border-black/10 bg-white p-7 sm:grid-cols-2" action="#" method="post">
      <label class="text-sm">Name<input required name="name" class="mt-2 w-full rounded-lg border border-black/15 px-4 py-3" /></label>
      <label class="text-sm">Business email<input required type="email" name="email" class="mt-2 w-full rounded-lg border border-black/15 px-4 py-3" /></label>
      <label class="text-sm">Company<input name="company" class="mt-2 w-full rounded-lg border border-black/15 px-4 py-3" /></label>
      <label class="text-sm">Country<input name="country" class="mt-2 w-full rounded-lg border border-black/15 px-4 py-3" /></label>
      <label class="text-sm">Product reference<input name="product" value={product} class="mt-2 w-full rounded-lg border border-black/15 px-4 py-3" /></label>
      <label class="text-sm">Estimated quantity<input name="quantity" class="mt-2 w-full rounded-lg border border-black/15 px-4 py-3" /></label>
      <label class="text-sm sm:col-span-2">What do you need?<textarea required name="message" rows="6" class="mt-2 w-full rounded-lg border border-black/15 px-4 py-3"></textarea></label>
      <div class="sm:col-span-2"><button class="btn-primary" type="submit">Send inquiry</button><p class="mt-3 text-xs text-muted">Form delivery and spam protection will be connected before launch.</p></div>
    </form>
  </section>
</Layout>
