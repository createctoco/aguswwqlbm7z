---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import { collections } from '~/data/products';

export const getStaticPaths = (() => collections.map((collection) => ({ params: { slug: collection.slug }, props: { collection } }))) satisfies GetStaticPaths;

const { collection } = Astro.props;
const metadata = {
  title: `${collection.name} | Wholesale Catholic Gifts`,
  description: `Browse ${collection.name.toLowerCase()} from the OUOOO wholesale Catholic gifts catalog and request sourcing information.`,
};
---
<Layout metadata={metadata}>
  <header class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-7xl px-6 py-14 sm:py-16">
      <nav class="text-sm text-muted" aria-label="Breadcrumb"><a class="hover:text-primary" href="/collections">Collections</a><span aria-hidden="true"> / </span><span>{collection.name}</span></nav>
      <p class="mt-8 text-xs font-bold uppercase tracking-[.2em] text-primary">Product series</p>
      <h1 class="mt-4 font-serif text-4xl text-gray-950 sm:text-5xl">{collection.name}</h1>
      <p class="mt-4 text-base text-muted">{collection.products.length} synchronized {collection.products.length === 1 ? 'product' : 'products'} in this collection.</p>
    </div>
  </header>
  <section class="mx-auto max-w-7xl px-6 py-14 sm:py-16">
    <div class="grid gap-x-7 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {collection.products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>
</Layout>
