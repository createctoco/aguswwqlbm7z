---
import Layout from '~/layouts/PageLayout.astro';
import ProductGallery from '~/components/ouooo/ProductGallery.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import { products, type Product } from '~/data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const metadata = { title: product.title, description: product.summary };
const categorySlugs = new Set(product.categories.map(({ slug }) => slug));
const related = products
  .filter((item) => item.slug !== product.slug)
  .sort((a, b) => Number(b.categories.some(({ slug }) => categorySlugs.has(slug))) - Number(a.categories.some(({ slug }) => categorySlugs.has(slug))))
  .slice(0, 3);
const schemas = Object.values(product.structuredData).filter(Boolean);
const inquiryUrl = `/contact?product=${encodeURIComponent(product.sku || product.title)}`;
const visibleSpecifications = product.specifications.slice(0, 8);
const extraSpecifications = product.specifications.slice(8);
---
<Layout metadata={metadata}>
  {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  <section class="mx-auto grid max-w-7xl gap-12 px-6 py-14 lg:grid-cols-2 lg:py-20">
    <ProductGallery product={product} />
    <div class="lg:py-7">
      <nav class="mb-5 flex flex-wrap gap-2" aria-label="Product collections">
        {product.categories.map((category) => <a class="rounded-full border border-black/15 px-3 py-1 text-xs font-semibold text-gray-700 hover:border-primary hover:text-primary" href={`/collections/${category.slug}`}>{category.name}</a>)}
      </nav>
      <p class="text-xs font-bold uppercase tracking-[.2em] text-primary">{product.eyebrow}</p>
      <h1 class="mt-4 font-serif text-4xl leading-tight text-gray-950 sm:text-5xl">{product.title}</h1>
      <p class="mt-6 text-lg leading-8 text-muted">{product.summary}</p>
      <dl class="mt-9 grid grid-cols-2 gap-5 border-y border-black/10 py-6 text-sm">
        <div><dt class="text-muted">Reference</dt><dd class="mt-1 break-all font-semibold">{product.sku || product.sourceId}</dd></div>
        <div><dt class="text-muted">Inquiry type</dt><dd class="mt-1 font-semibold">Wholesale sourcing</dd></div>
      </dl>
      <a href={inquiryUrl} class="btn-primary mt-8">Request a wholesale quote</a>
      <p class="mt-4 text-xs text-muted">Tell us your quantity, target market, and product requirements. We will reply with sourcing details.</p>
    </div>
  </section>

  <section class="bg-[#f4f5f2] py-16">
    <div class="mx-auto grid max-w-7xl items-start gap-6 px-6 md:grid-cols-2">
      <article class="detail-card">
        <p class="card-kicker">Product details</p>
        <h2>Overview</h2>
        <div class="mt-5 space-y-4 leading-7 text-gray-700">{product.description.split(/\n+/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}</div>
        {product.applications.length > 0 && <div class="mt-6"><h3>Applications</h3><ul class="mt-3 flex flex-wrap gap-2">{product.applications.slice(0, 4).map((item) => <li class="tag">{item}</li>)}</ul></div>}
      </article>

      <article class="detail-card">
        <p class="card-kicker">At a glance</p>
        <h2>Key features</h2>
        <ul class="mt-5 grid gap-3">{product.features.slice(0, 6).map((feature) => <li class="feature-item"><span>✓</span><span>{feature}</span></li>)}</ul>
        {product.catholicContext && <div class="context-box"><h3>Catholic context</h3><p>{product.catholicContext}</p></div>}
      </article>

      <article class="detail-card">
        <p class="card-kicker">Verified product data</p>
        <h2>Specifications</h2>
        <dl class="mt-5 divide-y divide-black/10 border-y border-black/10">{visibleSpecifications.map((item) => <div class="spec-row"><dt>{item.name}</dt><dd>{item.value}</dd></div>)}</dl>
        {extraSpecifications.length > 0 && <details class="mt-4"><summary class="cursor-pointer font-semibold text-primary">View all specifications ({product.specifications.length})</summary><dl class="mt-3 divide-y divide-black/10">{extraSpecifications.map((item) => <div class="spec-row"><dt>{item.name}</dt><dd>{item.value}</dd></div>)}</dl></details>}
      </article>

      <article class="detail-card">
        <p class="card-kicker">Wholesale sourcing</p>
        <h2>Buyer questions</h2>
        {product.faq.length > 0 ? <div class="mt-5 divide-y divide-black/10">{product.faq.slice(0, 4).map((item) => <details class="py-4"><summary class="cursor-pointer font-semibold text-gray-950">{item.question}</summary><p class="mt-3 leading-7 text-muted">{item.answer}</p></details>)}</div> : <p class="mt-5 leading-7 text-muted">Contact us with your quantity, market, or specification questions. We will confirm the available product details.</p>}
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20"><h2 class="font-serif text-4xl">Related products</h2><div class="mt-9 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">{related.map((item) => <ProductCard product={item} />)}</div></section>
</Layout>

<style>
  .detail-card{width:100%;border:1px solid rgb(37 42 38/.09);border-radius:1.25rem;background:#fff;padding:clamp(1.35rem,3vw,2rem);box-shadow:0 12px 34px rgb(36 42 37/.05)}
  .detail-card h2{margin-top:.35rem;font-family:var(--aw-font-serif,serif);font-size:clamp(1.65rem,3vw,2.15rem);line-height:1.15;color:#171b18}
  .detail-card h3{font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#3d493f}
  .card-kicker{font-size:.68rem;font-weight:700;letter-spacing:.17em;text-transform:uppercase;color:#526a55}
  .feature-item{display:grid;grid-template-columns:1.2rem 1fr;gap:.55rem;border-radius:.8rem;background:#f6f7f4;padding:.85rem 1rem;line-height:1.5;color:#303832}
  .feature-item>span:first-child{color:#526a55;font-weight:800}
  .context-box{margin-top:1.25rem;border-left:3px solid #526a55;border-radius:.75rem;background:#f4f1e9;padding:1rem 1.1rem}
  .context-box p{margin-top:.4rem;line-height:1.65;color:#5b625c}
  .tag{border-radius:999px;background:#eef1ec;padding:.45rem .8rem;font-size:.78rem;color:#485349}
  .spec-row{display:grid;grid-template-columns:minmax(7rem,.8fr) minmax(0,1.2fr);gap:1rem;padding:.75rem 0;font-size:.9rem;line-height:1.45}
  .spec-row dt{color:#6b746c}.spec-row dd{overflow-wrap:anywhere;font-weight:600;color:#252b26}
  @media(max-width:520px){.spec-row{grid-template-columns:1fr;gap:.25rem}}
</style>
