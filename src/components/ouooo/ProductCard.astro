---
import ProductVisual from './ProductVisual.astro';
import type { Product } from '~/data/products';
interface Props { product: Product }
const { product } = Astro.props;
---
<article class="group">
  <a href={`/products/${product.slug}`} aria-label={`View ${product.title}`}>
    <ProductVisual accent={product.accent} label={product.imageAlt} imageUrl={product.imageUrl} />
    <p class="mt-5 text-xs font-semibold uppercase tracking-[.14em] text-primary">{product.eyebrow}</p>
    <h3 class="mt-2 text-xl font-semibold leading-snug text-gray-900 group-hover:text-primary">{product.title}</h3>
    <p class="mt-2 text-sm leading-6 text-muted">{product.summary}</p>
  </a>
</article>
