---
import { BUILD_LOCALE, BUILD_LOCALE_CONFIG, LOCALES, PUBLISHED_LOCALES, getLocalizedUrl } from '~/i18n/config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const shortLabel = BUILD_LOCALE_CONFIG.hreflang.split('-')[0].toUpperCase();
---

<details class="language-switcher" data-language-switcher>
  <summary aria-label={`Change language. Current language: ${BUILD_LOCALE_CONFIG.label}`}>
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.4 2.45 3.6 5.45 3.6 9S14.4 18.55 12 21M12 3C9.6 5.45 8.4 8.45 8.4 12S9.6 18.55 12 21"
      ></path>
    </svg>
    <span>{compact ? shortLabel : BUILD_LOCALE_CONFIG.label}</span>
    <svg class="chevron" aria-hidden="true" viewBox="0 0 12 12"><path d="m2.5 4.25 3.5 3.5 3.5-3.5"></path></svg>
  </summary>
  <div class="language-menu" role="list" aria-label="Available languages">
    {
      PUBLISHED_LOCALES.map((locale) => (
        <a
          href={getLocalizedUrl(currentPath, locale)}
          lang={LOCALES[locale].hreflang}
          aria-current={locale === BUILD_LOCALE ? 'page' : undefined}
          role="listitem"
        >
          <span dir={LOCALES[locale].direction}>{LOCALES[locale].label}</span>
          {locale === BUILD_LOCALE && (
            <span class="current-mark" aria-hidden="true">
              ✓
            </span>
          )}
        </a>
      ))
    }
  </div>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-language-switcher]').forEach((switcher) => {
    document.addEventListener('click', (event) => {
      if (!switcher.contains(event.target as Node)) switcher.removeAttribute('open');
    });
    switcher.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        switcher.removeAttribute('open');
        switcher.querySelector<HTMLElement>('summary')?.focus();
      }
    });
  });
</script>

<style>
  .language-switcher {
    position: relative;
    z-index: 60;
  }

  summary {
    display: flex;
    min-height: 2.5rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgb(15 59 47 / 0.2);
    border-radius: 999px;
    background: #fff;
    padding: 0.5rem 0.8rem;
    color: #17211c;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  summary:focus-visible {
    border-color: #0f3b2f;
    color: #0f3b2f;
  }

  summary > svg:first-child {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.55;
  }

  .chevron {
    width: 0.7rem;
    height: 0.7rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 0.18s ease;
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  .language-menu {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    display: grid;
    width: min(15rem, calc(100vw - 1.5rem));
    max-height: min(31rem, calc(100vh - 6rem));
    overflow-y: auto;
    border: 1px solid rgb(15 59 47 / 0.14);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.98);
    padding: 0.45rem;
    box-shadow: 0 18px 50px rgb(21 33 27 / 0.16);
    backdrop-filter: blur(12px);
  }

  :global([dir='rtl']) .language-menu {
    right: auto;
    left: 0;
  }

  .language-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.7rem;
    padding: 0.65rem 0.75rem;
    color: #27332d;
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-decoration: none;
  }

  .language-menu a:hover {
    background: #f1f5f2;
    color: #0f3b2f;
  }

  .language-menu a[aria-current='page'] {
    background: #e9f0ec;
    color: #0f3b2f;
    font-weight: 700;
  }

  .current-mark {
    color: #0f3b2f;
  }

  @media (max-width: 767px) {
    summary {
      min-height: 2.25rem;
      padding: 0.42rem 0.62rem;
    }

    .language-menu {
      position: fixed;
      top: 4.25rem;
      right: 0.75rem;
      left: auto;
    }
  }
</style>
