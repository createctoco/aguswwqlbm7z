---
interface CardItem {
  title: string;
  text: string;
  badge?: string;
  label?: string;
  labelValue?: string;
}

interface Props {
  items: CardItem[];
  columns?: 2 | 3;
}

const { items, columns = 3 } = Astro.props;
const gridClass = columns === 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3';
---

<div class:list={['grid gap-5', gridClass]}>
  {
    items.map((item) => (
      <article class="rounded-2xl border border-black/10 bg-white p-6">
        {item.badge ? (
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-3xl font-semibold">{item.title}</h3>
            <span class="rounded-full bg-[#f6f1e8] px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-primary">
              {item.badge}
            </span>
          </div>
        ) : (
          <h3 class="text-lg font-semibold">{item.title}</h3>
        )}
        {item.label && (
          <>
            <p class="mt-4 text-sm font-semibold uppercase tracking-[.14em] text-muted">{item.label}</p>
            {item.labelValue && <p class="mt-2 text-lg font-semibold">{item.labelValue}</p>}
          </>
        )}
        <p class="mt-3 leading-7 text-muted">{item.text}</p>
      </article>
    ))
  }
</div>
