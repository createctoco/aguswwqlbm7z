---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Customization & OEM Guide – OUOOO',
  description:
    'OUOOO supports custom sourcing for wholesale rosaries, Catholic gifts, devotional jewelry, and related packaging. Materials, colors, branding, and packaging can be customized.',
};

const customizable = [
  ['Materials', 'Wood, glass, acrylic, plastic, natural stone, metal, cord, and mixed materials where suitable.'],
  ['Color and size', 'Bead color, bead diameter, cord color, plating, and coordinated color combinations.'],
  ['Religious components', 'Crucifix, cross, centerpiece, medal, saint image, charm, and related findings.'],
  ['Construction', 'Knot style, spacing, connectors, chain, elastic, and assembly method.'],
  ['Branding', 'Logo, parish or church name, laser marking, printing, insert cards, labels, and hangtags.'],
  ['Packaging', 'OPP bags, pouches, gift boxes, color boxes, display cards, barcodes, and private-label information.'],
];

const steps = [
  [
    '01',
    'Send a brief',
    'Provide a product link or reference, target quantity, destination, preferred material, colors, dimensions, packaging, and artwork.',
  ],
  [
    '02',
    'Feasibility review',
    'We review construction, tooling, compliance, MOQ, sample requirements, and an estimated schedule.',
  ],
  [
    '03',
    'Quotation',
    'You receive the proposed specification, price basis, sample or tooling charges, production lead time, and shipping assumptions.',
  ],
  [
    '04',
    'Sample approval',
    'Where sampling is required, bulk production starts only after the sample and written specification are approved.',
  ],
  [
    '05',
    'Production and inspection',
    'Production follows the approved reference. Inspection evidence or third-party inspection can be discussed before shipment.',
  ],
];

const briefItems = [
  'Clear reference photos from several angles.',
  'Editable artwork or a high-resolution logo where branding is required.',
  'Target dimensions, material, color references, and acceptable tolerances.',
  'Estimated order quantity and repeat-order expectation.',
  'Packaging format, barcode, labeling, and destination-market requirements.',
  'Delivery country and target date.',
];
---

<Layout metadata={metadata}>
  <section class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Customization &amp; OEM</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">
        Make it yours: custom sourcing and private label
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">
        OUOOO supports custom sourcing for wholesale rosaries, Catholic gifts, devotional jewelry, ornaments, and
        related packaging. Feasibility and minimum order quantity depend on the product, material, process, and design.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="btn-primary" href="/contact">Start a custom project</a>
        <a class="btn-secondary" href="/products">Browse products</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">What can be customized</p>
    <h2 class="mt-3 text-3xl font-semibold">Six areas we can tailor to your market</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        customizable.map(([title, text]) => (
          <article class="rounded-2xl border border-black/10 bg-white p-6">
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-3 leading-7 text-muted">{text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-[#f4f5f2] py-16">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">How a custom project works</p>
      <h2 class="mt-3 text-3xl font-semibold">Five steps from brief to production</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-5">
        {
          steps.map(([number, title, text]) => (
            <article class="rounded-2xl bg-white p-6">
              <span class="text-xs font-semibold text-primary">{number}</span>
              <h3 class="mt-3 text-lg font-semibold">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-8 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">What to include in your brief</p>
        <h2 class="mt-3 text-3xl font-semibold">The more detail, the more accurate the quote</h2>
        <p class="mt-5 leading-8 text-muted">
          A complete brief helps us review feasibility and give you a realistic quotation, sample plan, and schedule.
        </p>
      </div>
      <ul class="grid gap-3">
        {
          briefItems.map((item) => (
            <li class="flex items-start gap-3 rounded-2xl border border-black/10 bg-white p-4">
              <span class="mt-1 text-primary">✓</span>
              <span class="leading-7 text-muted">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-[#f6f1e8] py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="rounded-3xl bg-white p-8 sm:p-10">
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Important custom-order notes</p>
        <h2 class="mt-3 text-2xl font-semibold">Please read before you commit</h2>
        <p class="mt-5 leading-8 text-muted">
          Customized and made-to-order products are produced for one buyer and usually cannot be resold. After the
          approved sample or specification enters production, changes may create additional cost or delay. Reasonable
          natural-material, handcrafted, and batch variations should be agreed during sampling.
        </p>
        <p class="mt-4 leading-8 text-muted">
          Custom orders are generally not returnable for change of mind. If delivered goods materially differ from the
          approved sample or written specification, contact us promptly so the issue can be reviewed under our
          <a class="font-semibold text-primary" href="/returns">return policy</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-black/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-16 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Start a custom project</p>
        <h2 class="mt-3 text-3xl font-semibold">Send your requirements today</h2>
        <p class="mt-3 text-muted">
          Use the contact page to reach us through WhatsApp, WeChat, or email. Email is recommended when you need to
          attach artwork or specification files.
        </p>
      </div>
      <a class="btn-primary shrink-0" href="/contact">Contact OUOOO</a>
    </div>
  </section>
</Layout>
