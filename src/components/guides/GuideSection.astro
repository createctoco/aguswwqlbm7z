---
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  background?: 'default' | 'muted' | 'cream';
}

const { eyebrow, title, intro, background = 'default' } = Astro.props;
const bg = background === 'muted' ? 'bg-[#f4f5f2]' : background === 'cream' ? 'bg-[#f6f1e8]' : '';
const hasHeader = Boolean(eyebrow || title || intro);
---

<section class:list={[bg, 'py-16']}>
  <div class="mx-auto max-w-6xl px-6">
    {eyebrow && <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">{eyebrow}</p>}
    {title && <h2 class="mt-3 text-3xl font-semibold">{title}</h2>}
    {intro && <p class="mt-4 max-w-3xl leading-8 text-muted">{intro}</p>}
    <div class={hasHeader ? 'mt-8' : ''}>
      <slot />
    </div>
  </div>
</section>
